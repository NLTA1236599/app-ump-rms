PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ump_rms_db
DB_USER=ump_rms_user
# Same default as docker-compose POSTGRES_PASSWORD; override locally if yours differs.
DB_PASSWORD=change_me
# Must be non-empty; a blank JWT_SECRET breaks login (jsonwebtoken: secretOrPrivateKey must have a value).
JWT_SECRET=9598910426
# Comma-separated browser origins (page URL hosts). Include production HTTPS domains.
FRONTEND_ORIGIN=http://localhost:5173,https://ump-khcn.com,https://www.ump-khcn.com
# Public URL embedded in reminder email CTA buttons (must be HTTPS, not localhost).
APP_BASE_URL=https://www.ump-khcn.com

# Optional: seeded admin (npm run seed). Default username nltanh → login as nltanh@ump.edu.vn
# Run from repo root: npm run seed   — or from backend/: npm run seed
# SEED_ADMIN_USERNAME=nltanh
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_DISPLAY_NAME=Quản trị viên

# Registration OTP (email verification). TTL clamped to 5–30 minutes.
# OTP_TTL_MINUTES=10
# OTP_MAX_FAILED_ATTEMPTS=5

# SMTP for app mail (OTP + reminders). Prefer a domain mailbox with SPF/DKIM
# (e.g. no-reply@ump-khcn.com via Google Workspace / Zoho / SES). Personal Gmail
# often lands in Spam at @ump.edu.vn even when SMTP accepts the message.
# For Docker Compose, set these in the repo-root `.env` (gitignored).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=you@gmail.com
# MAIL_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM="UMP-RMS (Phần mềm QLKHCN P.KHCN) <you@gmail.com>"
# MAIL_REPLY_TO=you@gmail.com
