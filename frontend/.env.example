# Relative path (recommended): browser calls same host; Vite/nginx proxy /api → backend.
VITE_API_URL=/api/v1

# Local-only alternative (no proxy): point straight at the API process.
# VITE_API_URL=http://localhost:3001/api/v1

# Admin app URL for the header settings button (prod default: /admin/).
# VITE_ADMIN_APP_URL=http://localhost:5174/
